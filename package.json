{
  "name": "magnexis-voice",
  "version": "1.25.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "Magnexis Voice v1.25, independent community speech dataset recording and validation pilot",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "check": "node --test tests/*.test.mjs && node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron desktop/main.cjs",
    "desktop:build": "electron-builder --win --publish never --config desktop/electron-builder.yml",
    "precheck": "node scripts/prepare-site.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.4",
    "@netlify/database": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  }
}
